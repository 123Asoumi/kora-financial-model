{
  "name": "kora-bureau",
  "version": "1.0.14",
  "private": true,
  "description": "KORA-lite pour Windows : l'appli de bureau avec la bulle flottante",
  "author": "KORA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "bj.kora.lite.bureau",
    "productName": "KORA-lite",
    "copyright": "KORA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "outils.js",
      "preload-kora.js",
      "preload-bulle.js",
      "bulle.html",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icone.png",
      "artifactName": "KORA-lite-${version}-Windows.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "KORA-lite",
      "deleteAppDataOnUninstall": false
    }
  }
}
